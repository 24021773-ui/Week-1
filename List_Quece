#include <iostream>
using namespace std;
int arr[100];
int n = 0; 
//  O(1)
bool isEmpty() {
    return n == 0;
}
// O(1)
void enqueue(int x) {
    arr[n] = x;
    n++;
}
// O(n)
void dequeue() {
    if (isEmpty()) return;
    for (int i = 0; i < n - 1; i++) {
        arr[i] = arr[i + 1]; 
    }
    n--;
}
//  O(1)
int front() {
    if (isEmpty()) return -1;
    return arr[0];
}

//  O(1)
int size() {
    return n;
}
