using namespace std;
struct Node {
    int data;
    Node* next;
    Node* prev;
};
Node* NewNode(int x) {
    Node* newNode = new Node();
    newNode->data = x;
    newNode->next = NULL;
    newNode->prev = NULL;
    return newNode;
}
/ Truy cập phần tử tại vị trí k o(n)
void TruycapViTriK(Node* head, int k) {
    Node* p = head;
    int index = 0;
    while (p != NULL && index < k) {
        p = p->next;
        index++;
    }
    if (p == NULL) {
        cout << "Vi tri khong hop le!" << endl;
    } else {
        cout << "Phan tu tai vi tri " << k << " la: " << p->data << endl;
    }
}
